# GitHub PAT with access to private repos.
# Classic: MUST include the `repo` scope (not only public_repo).
# Fine-grained: select the private repos + Contents: Read.
# Used only by /api/github-stats — never expose as VITE_*.
#
# Se os privados estão na conta korvenlab, use o token dessa conta aqui:
GITHUB_TOKEN=

# Opcional: segundo token (ex. kleidsonadesign) se quiser separar as contas.
GITHUB_TOKEN_KORVEN=
